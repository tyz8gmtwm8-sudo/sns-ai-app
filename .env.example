# このファイルをコピーして「.env.local」という名前で保存し、値を入れてください。
# .env.local はGitに含まれない設定になっています（秘密情報を公開しないため）。

# Supabase（管理画面 → Project Settings → API Keys / Data API で確認）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Gemini API（https://aistudio.google.com/apikey で発行）
GEMINI_API_KEY=
# 使うモデル（空なら gemini-flash-latest）
GEMINI_MODEL=
# 混雑時に切り替える軽いモデル（空なら gemini-flash-lite-latest）
GEMINI_FALLBACK_MODEL=

# Resend（メール通知。https://resend.com で発行。空ならメールは送らずアプリ内通知のみ）
RESEND_API_KEY=
# 送信元アドレス（空なら Resend のテスト用 onboarding@resend.dev）
RESEND_FROM=
# メール内のリンクに使うアプリのURL（空なら今開いているURLを使う）
APP_URL=
